digraph G {
    graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
    node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11,
          color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
    edge [fontname="Times New Roman", fontsize=9, color="#555555"];

    start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
    end   [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];

    n0 [label="App.main(args)\nвзять args или DEFAULT_ITEMS\nEMPLOYEE / CATALOG",
        shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];

    n1 [label="OrderService.createOrder(EMPLOYEE)\nstatus = DRAFT"];

    n2 [label="Получить item (id:qty)\nApp.addLine → Order.addProduct",
        shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];

    n3 [label="Order.addProduct:\nvalidateQuantity(1..110), product != null"];

    d1 [label="Позиция корректна?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
    err1 [label="IllegalArgumentException\nобъект не изменён",
          fillcolor="#F4CCCC", color="#C00000"];

    d2 [label="Товар уже есть в заказе?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
    inc [label="item.increase(qty)\nпроверка quantity <= 110"];
    add [label="items.add(new OrderItem)"];
    incErr [label="IllegalArgumentException\nпревышен MAX_QUANTITY",
            fillcolor="#F4CCCC", color="#C00000"];

    d3 [label="Есть ещё позиции?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];

    total [label="total() = Σ lineTotal"];
    vc [label="OrderService.validateForConfirm(order)\nstatus = DRAFT, items не пуст"];
    d4 [label="Заказ можно подтвердить?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
    err2 [label="IllegalStateException\n(уже подтверждён / пуст)",
          fillcolor="#F4CCCC", color="#C00000"];

    conf [label="order.confirm()\nstatus = CONFIRMED"];
    lock [label="App: демонстрация запрета\naddProduct после confirm"];
    out  [label="App:\nвывести total, статус\nи сообщения об ошибках"];

    start -> n0;
    n0 -> n1;
    n1 -> n2;
    n2 -> n3;
    n3 -> d1;

    d1 -> d2   [label="да"];
    d1 -> err1 [label="нет"];
    err1 -> out;

    d2 -> inc [label="да"];
    d2 -> add [label="нет"];
    inc -> incErr [label="превышение"];
    incErr -> out;
    inc -> d3;
    add -> d3;

    d3 -> n2 [label="да"];
    d3 -> total [label="нет"];

    total -> vc;
    vc -> d4;
    d4 -> conf [label="да"];
    d4 -> err2 [label="нет"];
    err2 -> out;

    conf -> lock;
    lock -> out;
    out -> end;
}
